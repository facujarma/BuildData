# ─────────────────────────────────────────────────────────────────────────────
# BuildData — variables de PRODUCCIÓN
#
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#
# Un solo archivo sirve para los tres contenedores (backend, bot y caddy):
# cada proceso lee las que usa e ignora el resto.
#
# El .env real NUNCA se comitea (.gitignore ya lo excluye).
# Los valores que docker-compose.yml fija en `environment:` (PORT, SELF_URL, API_URL,
# NODE_ENV, TZ) ganan sobre este archivo, así que no hace falta repetirlos acá.
# ─────────────────────────────────────────────────────────────────────────────

# ── Caddy (TLS) ──────────────────────────────────────────────────────────────
# Dominio de la API: el registro DNS tipo A tiene que apuntar a la IP de la VPS.
# El Frontend de Vercel va a llamar a https://ESTE_DOMINIO (NEXT_PUBLIC_API_URL).
DOMAIN=api.tudominio.com
# Email para Let's Encrypt (avisos de vencimiento del certificado)
ACME_EMAIL=tu-email@dominio.com

# ── Compartidas entre Backend y Bot ──────────────────────────────────────────
# Clave AES-256-GCM de los links de invitación (!invitacion). 64 caracteres hex.
# Generar con:  openssl rand -hex 32
# Tiene que ser EXACTAMENTE la misma en los dos lados o los links fallan.
INVITACION_SECRET=

# Groq: LLM del bot (textToOperation), visión de comprobantes y ChatBot AI del backend
GROQ_API_KEY=

# Supabase: la service role key la usan el bot (subir fotos) y el backend (Storage)
SUPABASE_SERVICE_ROLE_KEY=

# ── Backend ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# OJO en una VPS con IPv4 solamente:
# Supabase migró la conexión DIRECTA a IPv6-only. Usá la cadena del POOLER
# (Dashboard → Connect → Connection pooling → Session mode, puerto 5432).
# La de "Direct connection" puede no resolver desde la VPS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# OpenAI: embeddings de entidades (pgvector). Opcional, default text-embedding-3-small
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Bot ──────────────────────────────────────────────────────────────────────
# Mongo: guarda el auth state de WhatsApp (colección baileys_auth).
# En Atlas → Network Access hay que habilitar la IP pública de la VPS.
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/builddata?retryWrites=true&w=majority

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
