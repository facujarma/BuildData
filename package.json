{
  "name": "my-project",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "bun run test:bot && bun run test:backend",
    "test:bot": "cd apps/WhatsApp-Bot && bun test",
    "test:backend": "bun test --isolate apps/Backend",
    "typecheck": "bun run typecheck:bot && bun run typecheck:frontend",
    "typecheck:bot": "cd apps/WhatsApp-Bot && bunx tsc --noEmit",
    "typecheck:frontend": "cd apps/Frontend && bunx tsc --noEmit",
    "check:backend": "find apps/Backend -name '*.js' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 node --check"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@unrs/resolver-binding-linux-x64-gnu": "1.11.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.2",
    "multer": "^2.1.1",
    "pg": "^8.20.0"
  }
}
